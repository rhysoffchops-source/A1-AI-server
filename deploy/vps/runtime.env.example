# Copy to deploy/runtime/runtime.env on the VPS, chmod 600, and replace every value.
# This file is deliberately ignored by the deployment scripts' source-control guidance.
# Do not place API tokens in production.yaml.

# Generate each with: openssl rand -base64 48
A1_SECRET_AUTH_TOKEN=replace-with-a-long-random-secret
A1_SECRET_SECRETS_MASTER_KEY=replace-with-a-different-long-random-secret

# This is the normal phrase you type at the A1 landing page. It is used only
# to create a short-lived browser session; do not reuse an API key or password.
A1_SECRET_DASHBOARD_PASSPHRASE=replace-with-a-long-unique-phrase

# Modal proxy token pair for the authenticated Code Watchdog endpoint.
A1_SECRET_MODAL_PROXY_TOKEN_ID=replace-with-modal-key
A1_SECRET_MODAL_PROXY_TOKEN_SECRET=replace-with-modal-secret

# Optional until compute.providers[0].enabled is set to true.
A1_SECRET_VAST_API_KEY=replace-with-vast-api-key

# Required for the enrolled M1 worker. The matching value is stored only in the
# M1 worker's protected local configuration.
A1_SECRET_WORKERS_M1_TOKEN=replace-with-random-worker-token

# ---- LLM Provider API Keys ----

# Venice.ai — uncensored text generation (primary playground provider)
VENICE_API_KEY=replace-with-venice-inference-key

# OpenRouter — multi-model gateway with :free tier
OPENROUTER_API_KEY=replace-with-openrouter-key

# Groq — fast inference (llama, mixtral)
GROQ_API_KEY=replace-with-groq-key

# Gemini / Google — maps + AI
GEMINI_API_KEY=replace-with-gemini-key

# Replicate — cloud image generation
REPLICATE_API_TOKEN=replace-with-replicate-token

# HuggingFace — inference API
HF_API_KEY=replace-with-huggingface-key

# Grok (xAI) — Grok models
GROK_API_KEY=replace-with-grok-key

# DeepSeek — reasoning models
DEEPSEEK_API_KEY=replace-with-deepseek-key

# Uncensored AI — unfiltered inference
UNCENSORED_AI_KEY=replace-with-uncensored-ai-key

# Brave Search — web search API
BRAVE_API_KEY=replace-with-brave-search-key

# Google Maps — for MCP maps tools (uses GEMINI_API_KEY as fallback if unset)
# GOOGLE_MAPS_API_KEY=replace-with-google-maps-key

# ---- MCP Multi-Node Bridge ----

# M1 Mac Studio Tailscale IP (for filesystem + puppeteer tools)
A1_MAC_STUDIO_IP=100.73.87.122

# Intel MacBook Tailscale IP (for secondary browser automation)
A1_MACBOOK_IP=100.73.87.123

# M1 Mac Studio address (Tailscale IP) for distributed MCP delegation
# and watchdog stealth evaluation.
A1_MAC_STUDIO_ADDRESS=http://100.73.87.122:11434

# Add a distinct token for each additional enrolled worker after its definition is added to production.yaml.
# A1_SECRET_WORKERS_INTEL_TOKEN=replace-with-random-worker-token
# A1_SECRET_WORKERS_VAST_GPU_TOKEN=replace-with-random-worker-token
